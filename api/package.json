{
  "name": "company-project-management-api",
  "version": "1.0.0",
  "description": "Mock REST API for a company project management platform prototype.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint . --max-warnings=200",
    "audit:prod": "npm audit --omit=dev --audit-level=low --workspace company-project-management-api",
    "smoke:local": "node scripts/smoke-local.js",
    "smoke:roles": "node scripts/full-flow-roles.js",
    "preflight:database": "node scripts/database-preflight.js",
    "verify:project-objective-migration": "node scripts/verify-project-objective-migration.js",
    "repair:project-objective-migration": "node scripts/repair-project-objective-migration.js --acknowledge",
    "export:postgres": "node scripts/export-sqlite-for-postgres.js",
    "verify:postgres-export": "node scripts/verify-postgres-export.js",
    "apply:postgres-schema": "node scripts/apply-postgres-schema.js",
    "import:postgres": "node scripts/import-ndjson-to-postgres.js",
    "reconcile:postgres-import": "node scripts/reconcile-postgres-import.js",
    "generate:postgres-target-report": "node scripts/generate-postgres-target-report.js",
    "drill:postgres-switch": "node scripts/postgres-switch-rollback-drill.js"
  },
  "keywords": [
    "project-management",
    "express",
    "mock-api"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "1.20.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.22.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.4"
  }
}
