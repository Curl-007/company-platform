# Runtime
NODE_ENV=development
PORT=4010
# Only SQLite is executable today. PostgreSQL is deliberately fail-closed
# until the asynchronous repository adapter and dual-environment verification
# described in docs/postgresql-migration-runbook.md are complete.
DATABASE_DIALECT=sqlite
DATABASE_FILE=./app.db
CORS_ORIGIN=http://localhost:5173

# Dev-only: set to 1 to skip API rate limits for trusted local browser sessions
# (localhost + Bearer, no forwarded headers). Never enable in production.
# RATE_LIMIT_TRUST_LOCAL=1

# Required in production. Use a random value of at least 16 characters.
JWT_SECRET=replace-with-a-secure-secret

# Required in production when persisting AI provider API keys (admin UI).
# Must be >= 16 chars and independent from JWT_SECRET. Local dev may fall back
# to JWT_SECRET with a warning when this is unset.
AI_CONFIG_ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key

# AI provider (optional; the application falls back to rule-based advice when not configured)
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_WIRE_API=chat_completions
AI_TIMEOUT_MS=30000
# OPENAI_API_KEY=

# Demo seed accounts are development-only. Do not set these in production.
# SEED_DEMO_DATA=1
# SEED_ADMIN_PASSWORD=
# SEED_PM_PASSWORD=
# SEED_DEV_PASSWORD=
# SEED_QA_PASSWORD=
# SEED_PDM_PASSWORD=
