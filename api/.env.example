# Runtime
NODE_ENV=development
PORT=4010
# Default remains sqlite for local/dev/CI.
# Wave 5: DATABASE_DIALECT=postgres is enabled when DATABASE_URL is set.
# Real dual-environment validation is W6. See docs/w2-postgres-plan.md and
# docs/postgresql-migration-runbook.md.
DATABASE_DIALECT=sqlite
DATABASE_FILE=./app.db
# PostgreSQL (optional). Never commit credentials.
# Apply schema first: npm run apply:postgres-schema -w api -- --connection <url>
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/pm
# POSTGRES_TARGET_URL=postgres://user:pass@127.0.0.1:5432/pm
# PG_POOL_MAX=10
CORS_ORIGIN=http://localhost:5173

# Dev-only: set to 1 to skip API rate limits for trusted local browser sessions
# (localhost + Bearer, no forwarded headers). Never enable in production.
# RATE_LIMIT_TRUST_LOCAL=1

# Required in production. Use a random value of at least 16 characters.
JWT_SECRET=replace-with-a-secure-secret

# Required in production when persisting AI provider API keys (admin UI).
# Must be >= 16 chars and independent from JWT_SECRET. Local dev may fall back
# to JWT_SECRET with a warning when this is unset.
AI_CONFIG_ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key

# AI control plane + DeepSeek Harness inference runtime (optional).
# The API owns the real Provider key and passes it only to its authenticated
# loopback proxy. Harness is the sole LLM execution runtime and receives an
# ephemeral per-runtime proxy token, never this real key.
AI_ENABLED=false
# Defaults used only when the API control plane has no persisted active Provider.
# Admin configuration can replace these values without exposing a key to clients.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_WIRE_API=chat_completions
AI_TIMEOUT_MS=30000
# Optional parent-process bootstrap key. Do not set any DSH_API_KEY/DSH_BASE_URL
# values here: the API generates child-only DSH_* values for each Harness runtime.
# AI_API_KEY=
# OPENAI_API_KEY=  # legacy bootstrap alias; prefer AI_API_KEY
# Private and reserved Provider addresses stay blocked by default. For a trusted
# local/intranet OpenAI-compatible model, allow only its exact host or IP here
# (comma-separated; do not include the scheme, port, path, wildcard, or CIDR).
# Example for http://192.168.3.18:8000/v1:
# AI_PROVIDER_PRIVATE_HOST_ALLOWLIST=192.168.3.18

# Optional API-only HMAC secret for short-lived, project-scoped capability
# execution tokens. It must be at least 16 characters. When unset, the API
# derives a domain-separated key from JWT_SECRET; this value never reaches the
# Harness child process or the execution gateway response.
# AI_CAPABILITY_TOKEN_SECRET=

# Isolated, persistent Harness home. It contains JSONL session records and
# accepted image attachments; keep it outside the web root and restrict it to
# the API service account. The default is ./storage/harness under api/.
HARNESS_HOME=./storage/harness
# Production always uses the checked-in company runtime composition and rejects
# HARNESS_RUNTIME_CONFIG, HARNESS_RUNTIME_COMMAND, and HARNESS_RUNTIME_ARGS.
# The following overrides exist only for local development/test diagnostics.
# HARNESS_RUNTIME_CONFIG=./config/harness/cordis.yml
# Optional local full runtime launch override. Set both variables together;
# ARGS must be a JSON array of strings.
# HARNESS_RUNTIME_COMMAND=/opt/company-platform/bin/dsh-jsonrpc-agent
# HARNESS_RUNTIME_ARGS=[]
# A runtime is recycled after this many serialized calls; lower it to reduce
# retained session lifetime. Per-request timeout remains AI_TIMEOUT_MS.
HARNESS_MAX_RUNS_PER_RUNTIME=20
HARNESS_DEFAULT_MAX_TOKENS=4096

# First production startup only. The bundled fixed initial admin account is
# admin@company.com / Admin@123456. Sign in with it, change the password, then
# remove both variables before restarting the service. Restarts never
# overwrite an already-created admin account or its password.
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@123456

# Demo seed accounts are development-only. Do not set these in production.
# SEED_DEMO_DATA=1
# SEED_PM_PASSWORD=
# SEED_DEV_PASSWORD=
# SEED_QA_PASSWORD=
# SEED_PDM_PASSWORD=
